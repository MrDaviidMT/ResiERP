APP_NAME=ResiERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=resierp
DB_USERNAME=resierp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Obligatorias para el sembrado: si faltan, `db:seed` se detiene con un error. Antes se
# generaba una contraseña aleatoria y nadie podía iniciar sesión en el despliegue.
ADMIN_PASSWORD=
DEMO_PASSWORD=

SESSION_DRIVER=database
# Tablets compartidas en planta: sesión corta y que caduque al cerrar el navegador
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
# La sesión guarda datos de salud consultados: se cifra en la base de datos
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS (obligatorio en producción): la cookie no viaja en claro
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Política de conservación (ver config/conservacion.php). Se estrena en simulación: solo informa.
CONSERVACION_SIMULACION=true
